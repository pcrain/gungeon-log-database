{
	"folders":
	[
		{
			"path": "."
		}
	],
  "build_systems":
  [
    {
        "name": "Build and Run",
        "shell_cmd": "bash $project_path/build.sh ",
        "working_dir": "${project_path}",
        "env": {"CLICOLOR_FORCE": "1",},
        "target": "ansi_color_build",
        "syntax": "Packages/ANSIescape/ANSI.sublime-syntax",
    },
    {
        "name": "Build and Run (Tests Only)",
        "shell_cmd": "bash $project_path/build.sh -t",
        "working_dir": "${project_path}",
        "env": {"CLICOLOR_FORCE": "1",},
        "target": "ansi_color_build",
        "syntax": "Packages/ANSIescape/ANSI.sublime-syntax",
    }
  ],
}
